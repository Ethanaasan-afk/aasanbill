# Demo mode — set both to true to skip Supabase and use in-memory sample data
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Public site URL used in WhatsApp short links (no trailing slash)
# Example: https://billing.yourdomain.com
NEXT_PUBLIC_APP_URL=https://YOUR_APP_DOMAIN

# Real Supabase (used when DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Metals.Dev API key (live gold/silver market reference on Today's Rates)
METALS_API_KEY=your-metals-dev-api-key
